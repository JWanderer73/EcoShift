# Root URL of the EcoShift API (API Gateway stage or Lambda Function URL), no trailing slash.
# Leave empty to run the UI on built-in sample data.
NEXT_PUBLIC_ECOSHIFT_API_URL=

# Deployed ECS API (this repo's /v1/forecast and /v1/windows) on the page's own origin:
#   NEXT_PUBLIC_ECOSHIFT_API_MODE=carbon-v1
# Local dev against `uvicorn carbon.api.main:app` without CORS: API_PROXY_URL=http://localhost:8000
NEXT_PUBLIC_ECOSHIFT_API_MODE=
