# Copy this file to .env and fill in your own values.
OPENAI_API_KEY=
DATA_PATH=data/raw
MODEL_NAME=baseline

# Free key from https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# Optional. Measured hourly gCO2/kWh for US-CAL-CISO.
# Register at https://www.electricitymaps.com/  (academic access for history and forecasts)
ELECTRICITY_MAPS_TOKEN=

# Optional. Marginal operating emissions. Register at https://www.watttime.org/
WATTTIME_USERNAME=
WATTTIME_PASSWORD=
